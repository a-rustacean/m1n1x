From: Dilshad <a-rustacean@outlook.com>
Date: Sat, 21 Nov 2026 12:00:00 +0000
Subject: [PATCH] platform Retain m1n1x correctness and CPU thermal fixes

Retain the downstream fixes and policy from commit 9b58444 on
GravityLinux/linux c7e7b86aed0c4c052851e5c3b2c02088c0602f02.
Hardware drivers and board enablement are supplied by Gravity, not
re-exported here. Original authorship and sign-offs remain in that
commit and the source files; this rebased integration has no new DCO
sign-off and is not an upstream submission. See docs/SOURCES.md.

---
diff --git a/drivers/cpufreq/apple-soc-cpufreq.c b/drivers/cpufreq/apple-soc-cpufreq.c
index c49fbd0..8e64f8f 100644
--- a/drivers/cpufreq/apple-soc-cpufreq.c
+++ b/drivers/cpufreq/apple-soc-cpufreq.c
@@ -16,11 +16,17 @@
 #include <linux/err.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
+#include <linux/jiffies.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
+#include <linux/percpu.h>
 #include <linux/pm_opp.h>
+#include <linux/pm_qos.h>
 #include <linux/slab.h>
+#include <linux/soc/apple/pmp-report.h>
+#include <linux/timer.h>
+#include <linux/workqueue.h>
 
 #define APPLE_DVFS_CMD				0x20
 #define APPLE_DVFS_CMD_BUSY			BIT(31)
@@ -69,10 +75,49 @@ struct apple_soc_cpufreq_info {
 	u64 ps1_shift;
 };
 
+/*
+ * PMP's fast die-temperature effort caps the cluster at the fastest state
+ * whose power fits (255 - effort) / 255 of the fastest state's. Busy CPUs
+ * sample it every tick; while a cap holds, a work item samples it too, so
+ * the cap lifts on an idle cluster.
+ */
+#define APPLE_FAST_DIE_EFFORT_MAX	255
+#define APPLE_FAST_DIE_FALLBACK_EFFORT	170
+#define APPLE_FAST_DIE_WAIT_MS		100
+#define APPLE_FAST_DIE_WARN_MS		30000
+
+struct apple_fast_die;
+
+struct apple_fast_die_timer {
+	struct timer_list timer;
+	struct apple_fast_die *fd;
+};
+
+struct apple_fast_die {
+	struct cpufreq_policy *policy;
+	struct device_node *report;
+	unsigned int lane;
+	/* Power of each frequency table entry, in uW */
+	unsigned long *power;
+	unsigned long max_power;
+	unsigned int max_freq;
+	unsigned int min_freq;
+	/* Current QoS value, in kHz */
+	unsigned int limit;
+	struct freq_qos_request req;
+	struct delayed_work work;
+	unsigned long sampled;
+	unsigned long warn_at;
+	bool warned;
+};
+
+static DEFINE_PER_CPU(struct apple_fast_die_timer, apple_fast_die_timers);
+
 struct apple_cpu_priv {
 	struct device *cpu_dev;
 	void __iomem *reg_base;
 	const struct apple_soc_cpufreq_info *info;
+	struct apple_fast_die *fast_die;
 };
 
 static struct cpufreq_driver apple_soc_cpufreq_driver;
@@ -205,9 +250,184 @@ static unsigned int apple_soc_cpufreq_fast_switch(struct cpufreq_policy *policy,
 	return policy->freq_table[policy->cached_resolved_idx].frequency;
 }
 
+static unsigned int apple_fast_die_limit(struct apple_fast_die *fd,
+					 unsigned int effort)
+{
+	struct cpufreq_frequency_table *pos;
+	unsigned long budget;
+	unsigned int limit = 0;
+	int i;
+
+	budget = fd->max_power * (APPLE_FAST_DIE_EFFORT_MAX - effort) /
+		 APPLE_FAST_DIE_EFFORT_MAX;
+
+	cpufreq_for_each_valid_entry_idx(pos, fd->policy->freq_table, i)
+		if (fd->power[i] <= budget && pos->frequency > limit)
+			limit = pos->frequency;
+
+	return limit ?: fd->min_freq;
+}
+
+static int apple_fast_die_sample(struct apple_fast_die *fd, unsigned int *limit)
+{
+	u8 effort;
+	int err;
+
+	err = apple_pmp_report_fast_die_effort(fd->report, fd->lane, &effort);
+	*limit = apple_fast_die_limit(fd, err ? APPLE_FAST_DIE_FALLBACK_EFFORT : effort);
+
+	return err;
+}
+
+static void apple_fast_die_tick(struct timer_list *t)
+{
+	struct apple_fast_die_timer *ft = timer_container_of(ft, t, timer);
+	struct apple_fast_die *fd = ft->fd;
+	unsigned long now = jiffies;
+	unsigned int limit;
+
+	if (xchg(&fd->sampled, now) != now) {
+		apple_fast_die_sample(fd, &limit);
+		if (limit != READ_ONCE(fd->limit))
+			mod_delayed_work(system_highpri_wq, &fd->work, 0);
+	}
+
+	mod_timer(t, now + 1);
+}
+
+static void apple_fast_die_work(struct work_struct *work)
+{
+	struct apple_fast_die *fd = container_of(to_delayed_work(work),
+						 struct apple_fast_die, work);
+	unsigned int limit;
+	int err;
+
+	err = apple_fast_die_sample(fd, &limit);
+	if (limit != fd->limit) {
+		freq_qos_update_request(&fd->req, limit);
+		WRITE_ONCE(fd->limit, limit);
+	}
+
+	if (err) {
+		if (!fd->warned && time_after(jiffies, fd->warn_at)) {
+			pr_warn("CPUs %*pbl: no PMP fast die-temperature limit (%d), held at %u kHz\n",
+				cpumask_pr_args(fd->policy->related_cpus), err, limit);
+			fd->warned = true;
+		}
+		queue_delayed_work(system_highpri_wq, &fd->work,
+				   msecs_to_jiffies(APPLE_FAST_DIE_WAIT_MS));
+	} else if (limit < fd->max_freq) {
+		queue_delayed_work(system_highpri_wq, &fd->work, 1);
+	}
+}
+
+static void apple_fast_die_exit(struct apple_fast_die *fd)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		struct apple_fast_die_timer *ft = per_cpu_ptr(&apple_fast_die_timers, cpu);
+
+		if (ft->fd == fd) {
+			timer_shutdown_sync(&ft->timer);
+			ft->fd = NULL;
+		}
+	}
+	cancel_delayed_work_sync(&fd->work);
+	freq_qos_remove_request(&fd->req);
+	of_node_put(fd->report);
+	kfree(fd->power);
+	kfree(fd);
+}
+
+static int apple_fast_die_init(struct cpufreq_policy *policy,
+			       struct device_node *cluster)
+{
+	struct apple_cpu_priv *priv = policy->driver_data;
+	struct cpufreq_frequency_table *pos;
+	struct of_phandle_args args;
+	struct apple_fast_die *fd;
+	int ret, cpu, i, n = 0;
+
+	ret = of_parse_phandle_with_fixed_args(cluster, "apple,fast-die-effort",
+					       1, 0, &args);
+	if (ret)
+		return ret == -ENOENT ? 0 : ret;
+
+	fd = kzalloc_obj(*fd);
+	if (!fd) {
+		of_node_put(args.np);
+		return -ENOMEM;
+	}
+	fd->policy = policy;
+	fd->report = args.np;
+	fd->lane = args.args[0];
+	fd->min_freq = UINT_MAX;
+
+	cpufreq_for_each_entry(pos, policy->freq_table)
+		n++;
+	fd->power = kcalloc(n, sizeof(*fd->power), GFP_KERNEL);
+	if (!fd->power) {
+		ret = -ENOMEM;
+		goto out_free;
+	}
+
+	cpufreq_for_each_valid_entry_idx(pos, policy->freq_table, i) {
+		unsigned long rate = pos->frequency * 1000UL + 999;
+		struct dev_pm_opp *opp;
+
+		opp = dev_pm_opp_find_freq_floor(priv->cpu_dev, &rate);
+		if (IS_ERR(opp)) {
+			ret = PTR_ERR(opp);
+			goto out_free;
+		}
+		fd->power[i] = dev_pm_opp_get_power(opp);
+		dev_pm_opp_put(opp);
+
+		if (!fd->power[i]) {
+			ret = -ENODATA;
+			goto out_free;
+		}
+		fd->max_power = max(fd->max_power, fd->power[i]);
+		fd->max_freq = max(fd->max_freq, pos->frequency);
+		fd->min_freq = min(fd->min_freq, pos->frequency);
+	}
+
+	fd->limit = apple_fast_die_limit(fd, APPLE_FAST_DIE_FALLBACK_EFFORT);
+	ret = freq_qos_add_request(&policy->constraints, &fd->req, FREQ_QOS_MAX,
+				   fd->limit);
+	if (ret < 0)
+		goto out_free;
+
+	fd->warn_at = jiffies + msecs_to_jiffies(APPLE_FAST_DIE_WARN_MS);
+	INIT_DELAYED_WORK(&fd->work, apple_fast_die_work);
+	queue_delayed_work(system_highpri_wq, &fd->work, 0);
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct apple_fast_die_timer *ft = per_cpu_ptr(&apple_fast_die_timers, cpu);
+
+		timer_setup(&ft->timer, apple_fast_die_tick,
+			    TIMER_DEFERRABLE | TIMER_PINNED);
+		ft->fd = fd;
+		ft->timer.expires = jiffies + 1;
+		if (cpu_online(cpu))
+			add_timer_on(&ft->timer, cpu);
+	}
+
+	priv->fast_die = fd;
+	return 0;
+
+out_free:
+	kfree(fd->power);
+	of_node_put(fd->report);
+	kfree(fd);
+	return ret;
+}
+
 static int apple_soc_cpufreq_find_cluster(struct cpufreq_policy *policy,
 					  void __iomem **reg_base,
-					  const struct apple_soc_cpufreq_info **info)
+					  const struct apple_soc_cpufreq_info **info,
+					  struct device_node **cluster)
 {
 	struct of_phandle_args args;
 	const struct of_device_id *match;
@@ -220,16 +440,20 @@ static int apple_soc_cpufreq_find_cluster(struct cpufreq_policy *policy,
 		return ret;
 
 	match = of_match_node(apple_soc_cpufreq_of_match, args.np);
-	of_node_put(args.np);
-	if (!match)
+	if (!match) {
+		of_node_put(args.np);
 		return -ENODEV;
+	}
 
 	*info = match->data;
 
 	*reg_base = of_iomap(args.np, 0);
-	if (!*reg_base)
+	if (!*reg_base) {
+		of_node_put(args.np);
 		return -ENOMEM;
+	}
 
+	*cluster = args.np;
 	return 0;
 }
 
@@ -242,6 +466,7 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 	struct apple_cpu_priv *priv;
 	const struct apple_soc_cpufreq_info *info;
 	struct cpufreq_frequency_table *freq_table;
+	struct device_node *cluster;
 
 	cpu_dev = get_cpu_device(policy->cpu);
 	if (!cpu_dev) {
@@ -253,7 +478,7 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 	if (!priv)
 		return -ENOMEM;
 
-	ret = apple_soc_cpufreq_find_cluster(policy, &reg_base, &info);
+	ret = apple_soc_cpufreq_find_cluster(policy, &reg_base, &info, &cluster);
 	if (ret) {
 		dev_err(cpu_dev, "%s: failed to get cluster info: %d\n", __func__, ret);
 		goto out_free_priv;
@@ -306,6 +531,11 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 	policy->fast_switch_possible = true;
 	policy->suspend_freq = freq_table[0].frequency;
 
+	ret = apple_fast_die_init(policy, cluster);
+	if (ret)
+		dev_warn(cpu_dev, "no fast die-temperature limit: %d\n", ret);
+	of_node_put(cluster);
+
 	return 0;
 
 out_free_cpufreq_table:
@@ -314,6 +544,7 @@ out_free_table:
 	dev_pm_opp_of_cpumask_remove_table(policy->cpus);
 out_iounmap:
 	iounmap(reg_base);
+	of_node_put(cluster);
 out_free_priv:
 	kfree(priv);
 	return ret;
@@ -323,6 +554,8 @@ static void apple_soc_cpufreq_exit(struct cpufreq_policy *policy)
 {
 	struct apple_cpu_priv *priv = policy->driver_data;
 
+	if (priv->fast_die)
+		apple_fast_die_exit(priv->fast_die);
 	dev_pm_opp_free_cpufreq_table(priv->cpu_dev, &policy->freq_table);
 	dev_pm_opp_of_cpumask_remove_table(policy->cpus);
 	iounmap(priv->reg_base);
diff --git a/drivers/cpuidle/cpuidle-apple.c b/drivers/cpuidle/cpuidle-apple.c
index 3d2b804..cbf0dd0 100644
--- a/drivers/cpuidle/cpuidle-apple.c
+++ b/drivers/cpuidle/cpuidle-apple.c
@@ -57,7 +57,43 @@ asm(
 	".popsection\n"
 );
 
+/*
+ * T8132: iBoot locks the power-down control on, so every wfi powers the core
+ * down and loses its registers. Writing the control raises an SError.
+ */
+asm(
+	".pushsection .cpuidle.text, \"ax\"\n"
+	".type apple_cpu_t8132_wfi, @function\n"
+	"apple_cpu_t8132_wfi:\n"
+		"str x30, [sp, #-16]!\n"
+		"stp x28, x29, [sp, #-16]!\n"
+		"stp x26, x27, [sp, #-16]!\n"
+		"stp x24, x25, [sp, #-16]!\n"
+		"stp x22, x23, [sp, #-16]!\n"
+		"stp x20, x21, [sp, #-16]!\n"
+		"stp x18, x19, [sp, #-16]!\n"
+
+	"1:\n"
+		"dsb sy\n"
+		"wfi\n"
+
+		"mrs x0, ISR_EL1\n"
+		"cbz x0, 1b\n"
+
+		"ldp x18, x19, [sp], #16\n"
+		"ldp x20, x21, [sp], #16\n"
+		"ldp x22, x23, [sp], #16\n"
+		"ldp x24, x25, [sp], #16\n"
+		"ldp x26, x27, [sp], #16\n"
+		"ldp x28, x29, [sp], #16\n"
+		"ldr x30, [sp], #16\n"
+
+		"ret\n"
+	".popsection\n"
+);
+
 void apple_cpu_deep_wfi(void);
+void apple_cpu_t8132_wfi(void);
 
 static __cpuidle int apple_enter_wfi(struct cpuidle_device *dev, struct cpuidle_driver *drv, int index)
 {
@@ -122,9 +158,57 @@ static struct cpuidle_driver apple_idle_driver = {
 	.state_count = STATE_COUNT,
 };
 
+static __cpuidle int apple_enter_t8132(struct cpuidle_device *dev,
+				       struct cpuidle_driver *drv, int index)
+{
+	/* The power-down loses the FP state too; the CPU PM notifiers save it. */
+	if (cpu_pm_enter())
+		return -1;
+
+	ct_cpuidle_enter();
+	apple_cpu_t8132_wfi();
+	ct_cpuidle_exit();
+
+	cpu_pm_exit();
+
+	return index;
+}
+
+/*
+ * Every wfi powers the core down, so cpu_do_idle() waits in wfe instead,
+ * with interrupts unmasked; that rules it out for s2idle.
+ */
+static struct cpuidle_driver apple_t8132_idle_driver = {
+	.name = "apple_idle",
+	.owner = THIS_MODULE,
+	.states = {
+		{
+			.enter			= apple_enter_wfi,
+			.exit_latency		= 1,
+			.target_residency	= 1,
+			.power_usage		= UINT_MAX,
+			.name			= "WFE",
+			.desc			= "CPU waiting for an event",
+		},
+		{
+			.enter			= apple_enter_t8132,
+			.enter_s2idle		= apple_enter_t8132,
+			.exit_latency		= 10,
+			.target_residency	= 100,
+			.power_usage		= 0,
+			.name			= "CPU PD",
+			.desc			= "CPU powered down",
+			.flags			= CPUIDLE_FLAG_RCU_IDLE,
+		},
+	},
+	.state_count = 2,
+};
+
+static struct cpuidle_driver *apple_driver = &apple_idle_driver;
+
 static int apple_cpuidle_probe(struct platform_device *pdev)
 {
-	return cpuidle_register(&apple_idle_driver, NULL);
+	return cpuidle_register(apple_driver, NULL);
 }
 
 static struct platform_driver apple_cpuidle_driver = {
@@ -146,7 +230,9 @@ static int __init apple_cpuidle_init(void)
 	if (!of_machine_is_compatible("apple,arm-platform"))
 		return 0;
 
-	if (!(of_machine_is_compatible("apple,t8103") ||
+	if (of_machine_is_compatible("apple,t8132"))
+		apple_driver = &apple_t8132_idle_driver;
+	else if (!(of_machine_is_compatible("apple,t8103") ||
 	      of_machine_is_compatible("apple,t8112") ||
 	      of_machine_is_compatible("apple,t8122") ||
 	      of_machine_is_compatible("apple,t6000") ||
diff --git a/drivers/gpio/gpio-macsmc.c b/drivers/gpio/gpio-macsmc.c
index 62107ef..60660a2 100644
--- a/drivers/gpio/gpio-macsmc.c
+++ b/drivers/gpio/gpio-macsmc.c
@@ -13,6 +13,8 @@
 #include <linux/hex.h>
 #include <linux/mfd/core.h>
 #include <linux/mfd/macsmc.h>
+#include <linux/property.h>
+#include <linux/slab.h>
 
 #define MAX_GPIO 64
 
@@ -76,6 +78,9 @@ struct macsmc_gpio {
 
 	int first_index;
 	smc_key base_key;
+	DECLARE_BITMAP(templated, MAX_GPIO);
+	DECLARE_BITMAP(template_values, MAX_GPIO);
+	u32 templates[MAX_GPIO];
 };
 
 static int macsmc_gpio_nr(smc_key key)
@@ -148,6 +153,9 @@ static int macsmc_gpio_get_direction(struct gpio_chip *gc, unsigned int offset)
 	u32 val;
 	int ret;
 
+	if (test_bit(offset, smcgp->templated))
+		return GPIO_LINE_DIRECTION_OUT;
+
 	/* First try reading the explicit pin mode register */
 	ret = apple_smc_rw_u32(smcgp->smc, key, CMD_PINMODE, &val);
 	if (!ret)
@@ -168,6 +176,9 @@ static int macsmc_gpio_get(struct gpio_chip *gc, unsigned int offset)
 	u32 cmd, val;
 	int ret;
 
+	if (test_bit(offset, smcgp->templated))
+		return test_bit(offset, smcgp->template_values);
+
 	ret = macsmc_gpio_get_direction(gc, offset);
 	if (ret < 0)
 		return ret;
@@ -188,17 +199,48 @@ static int macsmc_gpio_set(struct gpio_chip *gc, unsigned int offset, int value)
 {
 	struct macsmc_gpio *smcgp = gpiochip_get_data(gc);
 	smc_key key = macsmc_gpio_key(smcgp->base_key, offset);
+	bool templated = test_bit(offset, smcgp->templated);
+	u32 cmd = templated ? smcgp->templates[offset] : CMD_OUTPUT;
 	int ret;
 
-	value |= CMD_OUTPUT;
-	ret = apple_smc_write_u32(smcgp->smc, key, CMD_OUTPUT | value);
+	ret = apple_smc_write_u32(smcgp->smc, key, cmd | value);
 	if (ret < 0)
 		dev_err(smcgp->dev, "GPIO set failed %p4ch = 0x%x\n",
-			&key, value);
+			&key, cmd | value);
+	else if (templated)
+		assign_bit(offset, smcgp->template_values, value);
 
 	return ret < 0 ? ret : 0;
 }
 
+static int macsmc_gpio_read_templates(struct macsmc_gpio *smcgp)
+{
+	const char *prop = "apple,output-templates";
+	int i, n, ret;
+
+	if (!device_property_present(smcgp->dev, prop))
+		return 0;
+	n = device_property_count_u32(smcgp->dev, prop);
+	if (n < 0)
+		return n;
+	if (!n || n % 2 || n > 2 * MAX_GPIO)
+		return dev_err_probe(smcgp->dev, -EINVAL, "bad %s\n", prop);
+	u32 *vals __free(kfree) = kcalloc(n, sizeof(*vals), GFP_KERNEL);
+	if (!vals)
+		return -ENOMEM;
+	ret = device_property_read_u32_array(smcgp->dev, prop, vals, n);
+	if (ret)
+		return ret;
+	for (i = 0; i < n; i += 2) {
+		u32 line = vals[i], template = vals[i + 1];
+		if (line >= MAX_GPIO || template & 0xffff)
+			return dev_err_probe(smcgp->dev, -EINVAL, "bad output template\n");
+		smcgp->templates[line] = template;
+		set_bit(line, smcgp->templated);
+	}
+	return 0;
+}
+
 static int macsmc_gpio_init_valid_mask(struct gpio_chip *gc,
 				       unsigned long *valid_mask, unsigned int ngpios)
 {
@@ -253,6 +295,10 @@ static int macsmc_gpio_probe(struct platform_device *pdev)
 	smcgp->smc = smc;
 	smcgp->base_key = data ? data->base_key : _SMC_KEY("gP\0\0");
 
+	ret = macsmc_gpio_read_templates(smcgp);
+	if (ret)
+		return ret;
+
 	smcgp->first_index = macsmc_gpio_find_first_gpio_index(smcgp);
 	if (smcgp->first_index < 0)
 		return smcgp->first_index;
